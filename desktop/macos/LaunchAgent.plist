<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.relayhub.core</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/RelayHub.app/Contents/MacOS/relayhub</string>
        <string>-full-stack</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Logs previously went to world-readable /tmp paths (AUDIT RH-04/RH-31 hygiene);
         ~/Library/Logs keeps them inside the installing user's home. -->
    <key>StandardOutPath</key>
    <string>~/Library/Logs/relayhub.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>~/Library/Logs/relayhub.stderr.log</string>
</dict>
</plist>
